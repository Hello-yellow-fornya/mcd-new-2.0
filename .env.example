# Copy to .env.local for local development. Per-environment values live in
# Vercel; no secrets in the repo.

# Canonical, Open Graph and sitemap URLs (CLAUDE.md §0). Set this in Vercel to
# the project's own *.vercel.app production URL until a real domain is chosen;
# when one is, changing this one variable and attaching the domain is the
# whole switch. Unset, the site falls back to Vercel's
# VERCEL_PROJECT_PRODUCTION_URL, then to http://localhost:3000.
NEXT_PUBLIC_SITE_URL=https://mcd-new-2-0.vercel.app

# 2.0's own Google Tag Manager container (step 5). Nothing loads without it.
# NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX

# The shared 1.0 claims API (step 5). Claim-now posts here with source: "mcd2".
# CLAIMS_API_URL=https://<railway-service>.up.railway.app
# CLAIMS_API_KEY=

# Footer legal line (appendix §11). Exactly as on the FCA Register. On preview a
# visible [TODO] renders while unset; the production build stops until it is set.
# FCA_STATUS_LINE="Motor Claims Department Ltd is authorised and regulated by the Financial Conduct Authority, firm reference number 000000."
